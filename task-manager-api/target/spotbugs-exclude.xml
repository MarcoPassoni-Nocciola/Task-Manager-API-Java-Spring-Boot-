<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Example: ignore findings in test classes -->
  <Match>
    <Class name="~.*Test$"/>
  </Match>

  <!-- Example: ignore a specific bug pattern for a given class -->
  <!--
  <Match>
    <Class name="com.devops.tasks.TaskService"/>
    <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
  </Match>
  -->

  <!-- Generic: ignore findings in generated code packages -->
  <Match>
    <!-- regex: any package segment 'generated' -->
    <Class name="~.*\\.generated\\..*"/>
  </Match>

  <!-- Generic: ignore unread-field warnings for DTO classes (common and often benign) -->
  <Match>
    <Class name="~.*DTO$"/>
    <Bug pattern="URF_UNREAD_FIELD"/>
  </Match>

  <!-- Generic: ignore missing serialVersionUID warnings for DTOs -->
  <Match>
    <Class name="~.*DTO$"/>
    <Bug pattern="SE_NO_SERIALVERSIONID"/>
  </Match>

  <!-- Example: ignore findings annotated as generated (uncomment if supported by analysis)
  <Match>
    <Class>
      <Annotation name="javax.annotation.Generated"/>
    </Class>
  </Match>
  -->
</FindBugsFilter>
